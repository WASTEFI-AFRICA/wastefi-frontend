# Base URL of the WasteFi backend API, including the version prefix.
# Must be set when the app is BUILT: Next.js inlines NEXT_PUBLIC_* values at build time.
# Local backend. Start it with PORT=3001 so it does not collide with this app on 3000:
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Optional: the backend's DEMO_ACCOUNT_PASSWORD. When set, the sign-in page shows the
# demo accounts with one-click "Sign in" buttons. Public on purpose; testnet demo only.
NEXT_PUBLIC_DEMO_PASSWORD=
